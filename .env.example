# Пример конфигурации окружения

# Настройки базы данных
DB_PATH=data/avito_ads.db

# Настройки логирования
LOG_LEVEL=INFO
LOG_DIR=logs

# Настройки парсера
HEADLESS_MODE=true
PAGE_LOAD_TIMEOUT=10
REQUEST_DELAY=3

# Прокси (опционально)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
